# ---- Database ----
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/content_engine?schema=public"

# ---- Auth (필수) ----
# openssl rand -base64 32
AUTH_SECRET="change-me"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"
# 선택: 소셜 로그인 (값이 있을 때만 활성화)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# ---- 비밀정보 암호화 (OAuth 토큰 저장용, 32바이트 base64) ----
# openssl rand -base64 32
ENCRYPTION_KEY="change-me-32-bytes-base64"

# ---- 앱 ----
APP_URL="http://localhost:3000"
# 개발 편의: inline이면 enqueue 직후 같은 프로세스에서 Job 처리. worker면 `npm run worker` 필요
JOB_RUNNER="inline"

# ---- 제품 분석 (auto | mock) ----
PRODUCT_ANALYZER="auto"

# ---- AI ----
# mock | anthropic | openai
AI_PROVIDER="mock"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4.1-mini"

# ---- TTS ----
# mock | edge(무료, 키 불필요, 한국어 ko-KR-SunHiNeural) | openai
TTS_PROVIDER="edge"
# edge 음성: default(여성) | male(남성) | ko-KR-... 음성 이름 직접 지정
EDGE_TTS_VOICE="default"

# ---- Storage ----
# local | s3
STORAGE_PROVIDER="local"
STORAGE_LOCAL_DIR="./storage"
S3_ENDPOINT=""
S3_REGION="ap-northeast-2"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# ---- Rendering ----
# 비우면 playwright-core 기본 경로 사용
CHROMIUM_PATH=""
# 비우면 ffmpeg-static 사용
FFMPEG_PATH=""

# ---- Publishing ----
# mock | threads
THREADS_PUBLISHER="mock"
THREADS_APP_ID=""
THREADS_APP_SECRET=""
WEBHOOK_SECRET=""
